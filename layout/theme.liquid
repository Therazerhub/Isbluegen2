<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="{{ settings.color_mode | default: 'light' }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title | escape }}{% unless page_title contains shop.name %} | {{ shop.name | escape }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:title" content="{{ page_title | escape }}"><meta property="og:type" content="website"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:site_name" content="{{ shop.name | escape }}">
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  <meta name="theme-color" content="#1647ed">
  <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
  {{ 'manrope-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{--accent:{{ settings.accent_color | default: '#1647ed' }};--page-width:{{ settings.page_width | default: 1440 }}px}</style>
  {{ content_for_header }}
  <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
</head>
<body>
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% render 'drawers' %}
  <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
  <script type="application/json" id="isblue-config">{"root":{{ routes.root_url | json }},"currency":{{ cart.currency.iso_code | default: shop.currency | json }},"locale":{{ request.locale.iso_code | json }},"cartUrl":{{ routes.cart_url | json }}}</script>
</body>
</html>
