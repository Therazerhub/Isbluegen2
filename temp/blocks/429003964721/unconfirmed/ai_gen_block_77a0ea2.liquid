{% doc %}
  @prompt
    cash on delivery text block, make it in center middle 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cod-note-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.5;
    text-align: center;
  }

  .ai-cod-note-{{ ai_gen_id }}__content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .ai-cod-note-{{ ai_gen_id }}__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: {{ block.settings.icon_background }};
    color: {{ block.settings.icon_color }};
  }

  .ai-cod-note-{{ ai_gen_id }}__icon svg {
    display: block;
    width: 21px;
    height: 21px;
  }

  .ai-cod-note-{{ ai_gen_id }}__text {
    min-width: 0;
    text-align: center;
  }

  .ai-cod-note-{{ ai_gen_id }}__heading {
    display: block;
    margin: 0 0 2px;
    font-size: 1em;
    font-weight: 700;
  }

  .ai-cod-note-{{ ai_gen_id }}__message {
    margin: 0;
    font-size: 0.9em;
  }

  @media screen and (max-width: 749px) {
    .ai-cod-note-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-cod-note-{{ ai_gen_id }}" role="note" {{ block.shopify_attributes }}>
  <div class="ai-cod-note-{{ ai_gen_id }}__content">
    <span class="ai-cod-note-{{ ai_gen_id }}__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.5" y="5" width="19" height="14" rx="2" />
        <path d="M2.5 10h19M7 15h3" />
      </svg>
    </span>
    <div class="ai-cod-note-{{ ai_gen_id }}__text">
      {% if block.settings.heading != blank %}
        <strong class="ai-cod-note-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</strong>
      {% endif %}
      {% if block.settings.message != blank %}
        <p class="ai-cod-note-{{ ai_gen_id }}__message">{{ block.settings.message | escape }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cash on delivery note",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cash on delivery available" },
    { "type": "text", "id": "message", "label": "Supporting text", "default": "Pay for your order when it arrives." },
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F5F7FF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#17213C" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#D7DFF5" },
    { "type": "color", "id": "icon_background", "label": "Icon background", "default": "#1647ED" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#FFFFFF" },
    { "type": "range", "id": "font_size", "label": "Text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding", "label": "Padding", "min": 8, "max": 32, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Cash on delivery note" }],
  "tag": null,
  "class": "cash-on-delivery-note"
}
{% endschema %}