<article class="product-card">
  <a class="product-image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '250,400,550,700,900', sizes: '(max-width: 767px) 75vw, 25vw', class: 'product-image', alt: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'product-image placeholder' }}{% endif %}{% if product.compare_at_price > product.price %}{% assign card_saving = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}<strong class="product-discount-badge">{{ card_saving }}% OFF</strong>{% endif %}</a>
  <div class="product-card-meta"><span>{{ product.type | default: 'The everyday edit' | escape }}</span><span class="product-quality-label">ISBLUE PICK</span></div>
  <h3><a href="{{ product.url }}">{{ product.title | split: ' — ' | first | split: ' | ' | first | escape }}</a></h3>
  <div class="product-card-bottom"><p class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>{% if product.available %}{% if product.has_only_default_variant %}<form method="post" action="{{ routes.cart_add_url }}" data-product-form><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="quick-add quick-add--labelled" type="submit" aria-label="Add {{ product.title | escape }} to bag"><span>Add</span>{% render 'icon', name: 'plus' %}</button><p class="form-message" role="status"></p></form>{% else %}<a class="quick-add quick-add--labelled" href="{{ product.url }}" aria-label="Choose options for {{ product.title | escape }}"><span>View</span>{% render 'icon', name: 'arrow-up-right' %}</a>{% endif %}{% else %}<span class="sold-out">Sold out</span>{% endif %}</div>
  <p class="product-card-cod">{% render 'icon', name: 'truck' %} Cash on Delivery available</p>
</article>
