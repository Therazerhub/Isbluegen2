<dialog id="search-dialog" class="search-dialog"><div class="drawer-heading"><h2>Find your next good thing.</h2><button class="icon-button" data-close aria-label="Close search">{% render 'icon', name: 'x' %}</button></div><form action="{{ routes.search_url }}" method="get" class="search-form"><label class="visually-hidden" for="SearchInput">Search products</label><input id="SearchInput" name="q" type="search" placeholder="What are you looking for?" autocomplete="off" data-search-input><input name="type" type="hidden" value="product"><button class="icon-button" aria-label="Submit search">{% render 'icon', name: 'magnifying-glass' %}</button></form><div data-search-results aria-live="polite"><p class="search-hint">Try a pocket printer, a home upgrade, or your next travel essential.</p></div></dialog>
<dialog id="menu-dialog" class="drawer menu-drawer"><div class="drawer-heading"><h2>Explore IsBlue</h2><button class="icon-button" data-close aria-label="Close menu">{% render 'icon', name: 'x' %}</button></div><nav aria-label="Mobile navigation"><a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/contact">Contact</a><a href="{{ routes.account_url }}">My account</a></nav></dialog>
