<dialog id="cart-dialog" class="drawer"><div class="drawer-heading"><h2>Your bag <span data-cart-count>{{ cart.item_count }}</span></h2><button class="icon-button" data-close aria-label="Close bag">{% render 'icon', name: 'x' %}</button></div><div class="cart-lines" data-cart-lines><p>Your bag is loading.</p></div><p class="cart-error" role="alert" data-cart-error></p><div class="drawer-total"><div><span>Subtotal</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div><p>Shipping, taxes, and discounts calculated at checkout.</p><form method="post" action="{{ routes.cart_url }}"><button class="button button-primary full-width" name="checkout" type="submit">Continue to checkout {% render 'icon', name: 'arrow-up-right' %}</button></form><a class="cart-page-link" href="{{ routes.cart_url }}">View your bag</a></div></dialog>
<dialog id="search-dialog" class="search-dialog"><div class="drawer-heading"><h2>Find your next good thing.</h2><button class="icon-button" data-close aria-label="Close search">{% render 'icon', name: 'x' %}</button></div><form action="{{ routes.search_url }}" method="get" class="search-form"><label class="visually-hidden" for="SearchInput">Search products</label><input id="SearchInput" name="q" type="search" placeholder="What are you looking for?" autocomplete="off" data-search-input><input name="type" type="hidden" value="product"><button class="icon-button" aria-label="Submit search">{% render 'icon', name: 'magnifying-glass' %}</button></form><div data-search-results aria-live="polite"><p class="search-hint">Try a pocket printer, a home upgrade, or your next travel essential.</p></div></dialog>
<dialog id="menu-dialog" class="drawer menu-drawer"><div class="drawer-heading"><h2>Explore IsBlue</h2><button class="icon-button" data-close aria-label="Close menu">{% render 'icon', name: 'x' %}</button></div><nav aria-label="Mobile navigation"><a href="{{ routes.all_products_collection_url }}">Products</a><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a><a href="{{ routes.all_products_collection_url }}">Shop all</a></nav></dialog>
