{% assign item_variant = item.selected_or_first_available_variant %}
<article class="home-product-card">
  <a class="home-product-photo" href="{{ item.url }}" aria-label="{{ item.title | escape }}">
    {% if item.featured_image %}{{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '200,350,550,700', sizes: '(min-width: 990px) 24vw, 48vw', alt: item.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'home-placeholder' }}{% endif %}
    {% if item_variant.compare_at_price > item_variant.price %}{% assign saving = item_variant.compare_at_price | minus: item_variant.price | times: 100 | divided_by: item_variant.compare_at_price | floor %}<span class="home-saving">{{ saving }}% off</span>{% endif %}
    <span class="home-product-explore" aria-hidden="true">{% render 'icon', name: 'arrow-up-right' %}</span>
  </a>
  <div class="home-product-copy"><p class="home-product-category">{{ item.type | default: 'Everyday essentials' | escape }}</p><h3><a href="{{ item.url }}">{{ item.title | split: ' — ' | first | split: ' | ' | first | escape }}</a></h3>
  {% if item.metafields.custom.short_benefit.value != blank %}<p class="home-product-benefit">{{ item.metafields.custom.short_benefit.value | escape }}</p>{% endif %}
  <p class="home-product-price">{{ item_variant.price | money }}{% if item_variant.compare_at_price > item_variant.price %}<s>{{ item_variant.compare_at_price | money }}</s>{% endif %}</p>
  {% if item.available %}{% if item.variants.size == 1 %}<form method="post" action="{{ routes.cart_add_url }}" data-product-form><input type="hidden" name="id" value="{{ item_variant.id }}"><button class="home-card-button" type="submit">Add to bag{% render 'icon', name: 'plus' %}</button><p class="form-message" role="status"></p></form>{% else %}<a class="home-card-button" href="{{ item.url }}">Choose options{% render 'icon', name: 'arrow-up-right' %}</a>{% endif %}{% else %}<button class="home-card-button" disabled>Sold out</button>{% endif %}</div>
</article>
