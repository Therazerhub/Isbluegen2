<section class="home-buying-guide home-section page-width" data-home-reveal>
  <div class="home-guide-copy"><p class="home-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="home-text-link" href="/pages/contact">Ask us a question{% render 'icon', name: 'arrow-up-right' %}</a><div class="home-guide-seal">{% render 'icon', name: 'shield-check' %}<span>Secure checkout<br><small>Payments handled through Shopify.</small></span></div></div>
  <div class="home-faq-list">{% for block in section.blocks %}<details class="home-faq" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}{% render 'icon', name: 'plus' %}</summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div>
</section>
<section class="home-final"><div class="page-width"><div><p class="home-eyebrow">{{ section.settings.final_eyebrow | escape }}</p><h2>{{ section.settings.final_heading | escape }}</h2></div><a class="home-button" href="{{ routes.all_products_collection_url }}">Shop everyday solutions{% render 'icon', name: 'arrow-up-right' %}</a></div></section>
{% schema %}
{"name":"Buying questions and CTA","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A LITTLE CLARITY"},{"type":"text","id":"heading","label":"Heading","default":"Good questions. Clear answers."},{"type":"textarea","id":"description","label":"Description","default":"Know what to expect before you add something to your everyday."},{"type":"text","id":"final_eyebrow","label":"Final eyebrow","default":"LESS HASSLE. MORE EVERYDAY."},{"type":"text","id":"final_heading","label":"Final heading","default":"Find something that makes life easier."}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How can we help?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Contact our team for more information.</p>"}]}],"max_blocks":10,"presets":[{"name":"Buying questions and CTA"}]}
{% endschema %}
