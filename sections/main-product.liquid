{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign promotion_ends_at = product.metafields.custom.promotion_ends_at.value | default: section.settings.promotion_ends_at %}
<section class="product-page product-universal page-width section-space" data-design="{{ section.settings.design }}" data-product-page {% if section.settings.reveal %}data-product-reveal{% endif %}><nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.all_products_collection_url }}">Products</a></nav><div class="product-layout"><div class="product-gallery"><div class="main-media">{% for media in product.media %}<div data-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>{% case media.media_type %}{% when 'image' %}{% assign media_loading = 'lazy' %}{% if forloop.first %}{% assign media_loading = 'eager' %}{% endif %}<a class="product-zoom" {% if section.settings.zoom %}data-product-zoom{% endif %} href="{{ media | image_url: width: 2400 }}" target="_blank" rel="noopener" aria-label="View full size image">{{ media | image_url: width: 2000 | image_tag: loading: media_loading, widths: '400,700,1000,1400,2000', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt }}</a>{% when 'video' %}{{ media | video_tag: controls: true, image_size: '1000x', preload: 'none' }}{% when 'external_video' %}{{ media | external_video_tag: loading: 'lazy' }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder product-placeholder' }}{% endfor %}{% if product.media.size > 0 %}<div class="product-gallery-index" aria-label="Product media {{ product.media.size }}"><span data-media-current>01</span><span class="product-gallery-index-rule"></span><span>{{ product.media.size | prepend: '0' }}</span></div>{% endif %}</div><div class="thumbnails">{% for media in product.media %}<button type="button" data-media-target="{{ media.id }}" aria-label="View media {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endfor %}</div></div><div class="product-info" data-sticky="{{ section.settings.sticky_info }}"><p class="eyebrow">{{ product.type | default: 'THE ISBLUE EDIT' | escape }}</p><h1>{{ product.title | escape }}</h1>{% if product.metafields.custom.subtitle.value != blank %}<p class="product-subtitle">{{ product.metafields.custom.subtitle.value | escape }}</p>{% endif %}<div class="price product-main-price"><span data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span><s data-product-compare>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}{{ product.selected_or_first_available_variant.compare_at_price | money }}{% endif %}</s><span class="product-sale-chip" data-product-discount {% unless selected_variant.compare_at_price > selected_variant.price %}hidden{% endunless %}>{% if selected_variant.compare_at_price > selected_variant.price %}{% assign discount_percent = selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price | floor %}{{ discount_percent }}% off{% endif %}</span></div><p class="tax-note">{% if cart.taxes_included %}Tax included. {% endif %}Shipping calculated at checkout.</p>{% form 'product', product, data-product-form: '', class: 'main-product-form' %}{% if product.variants.size > 1 %}<label for="Variant-{{ section.id }}">Choose your option</label>{% endif %}<select name="id" id="Variant-{{ section.id }}" data-variant-select {% if product.variants.size <= 1 %}class="visually-hidden" aria-label="Product variant"{% endif %}>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select><div class="purchase-row"><div class="quantity"><button type="button" data-quantity="-1" aria-label="Decrease quantity">−</button><label class="visually-hidden" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" min="1" value="1" name="quantity" inputmode="numeric"><button type="button" data-quantity="1" aria-label="Increase quantity">+</button></div><button type="submit" class="button button-primary" data-add-button {% unless selected_variant.available %}disabled{% endunless %}><span data-add-label>{% if selected_variant.available %}Add to bag{% else %}Sold out{% endif %}</span> {% render 'icon', name: 'handbag' %}</button></div><p class="form-message" role="status"></p>{% if section.settings.dynamic_checkout %}{{ form | payment_button }}{% endif %}{% endform %}{% if section.settings.show_promotion_timer and promotion_ends_at != blank %}<div class="purchase-promotion" data-promotion-timer data-promotion-end="{{ promotion_ends_at | escape }}" data-promotion-sale="{% if selected_variant.compare_at_price > selected_variant.price %}true{% else %}false{% endif %}" hidden><div class="purchase-promotion-copy"><span class="purchase-promotion-dot" aria-hidden="true"></span><span>{{ section.settings.promotion_label | escape }}</span></div><div class="purchase-promotion-time" aria-label="Time remaining"><span data-days>00</span><i>:</i><span data-hours>00</span><i>:</i><span data-minutes>00</span><i>:</i><span data-seconds>00</span></div></div>{% endif %}{% if section.blocks.size > 0 %}<div class="purchase-trust" aria-label="Shopping information">{% for block in section.blocks %}{% if block.type == 'trust_badge' %}{% if block.settings.link != blank %}<a class="purchase-trust-item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% else %}<div class="purchase-trust-item" {{ block.shopify_attributes }}>{% endif %}<span class="purchase-trust-icon">{% render 'icon', name: block.settings.icon %}</span><span><strong>{{ block.settings.heading | escape }}</strong>{% if block.settings.caption != blank %}<small>{{ block.settings.caption | escape }}</small>{% endif %}</span>{% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}{% endif %}{% endfor %}</div>{% endif %}<div class="purchase-benefits"><span>{% render 'icon', name: 'shield-check' %} Secure checkout</span><a href="/pages/contact">{% render 'icon', name: 'chat-circle-text' %} Need a hand?</a></div>{% if product.description != blank %}<a class="product-details-link" href="#ProductDetails">Discover the details ↘</a>{% endif %}<details class="product-disclosure"><summary>Delivery & returns {% render 'icon', name: 'plus' %}</summary><p>Find delivery information in our <a href="/policies/shipping-policy">shipping policy</a> and eligibility in our <a href="/policies/refund-policy">returns policy</a>. Contact us if you need help before ordering.</p></details>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% endcase %}{% endfor %}</div></div>
<noscript><style>.product-universal [data-media-id][hidden]{display:block!important}.product-universal .thumbnails{display:none}</style></noscript>
<script type="application/json" data-variants>{{ product.variants | json }}</script></section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "Visual variation",
      "default": "original",
      "options": [
        {
          "value": "original",
          "label": "Cinematic original"
        },
        {
          "value": "minimal",
          "label": "White editorial"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "zoom",
      "label": "Enable desktop hover zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Enable scroll reveals",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dynamic_checkout",
      "label": "Show dynamic checkout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "Sticky desktop purchase panel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_promotion_timer",
      "label": "Show offer countdown when discounted",
      "default": false,
      "info": "Also needs a future deadline below or a product custom.promotion_ends_at date-time metafield."
    },
    {
      "type": "text",
      "id": "promotion_label",
      "label": "Offer countdown label",
      "default": "Offer ends in"
    },
    {
      "type": "text",
      "id": "promotion_ends_at",
      "label": "Fallback offer deadline (ISO 8601)",
      "info": "Example: 2026-12-31T23:59:00+05:30. Product metafield takes priority. Leave empty for no countdown."
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust detail",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield-check",
          "options": [
            {"value": "shield-check", "label": "Shield"},
            {"value": "chat-circle-text", "label": "Support"},
            {"value": "handbag", "label": "Bag"},
            {"value": "sparkle", "label": "Sparkle"}
          ]
        },
        {"type": "text", "id": "heading", "label": "Heading", "default": "Secure checkout"},
        {"type": "text", "id": "caption", "label": "Supporting text"},
        {"type": "url", "id": "link", "label": "Optional link"}
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
