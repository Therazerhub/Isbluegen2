{% assign selected_variant = product.selected_or_first_available_variant %}
<section class="product-page product-universal page-width section-space" data-product-page {% if section.settings.reveal %}data-product-reveal{% endif %}><nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.all_products_collection_url }}">Products</a></nav><div class="product-layout"><div class="product-gallery"><div class="main-media">{% for media in product.media %}<div data-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>{% case media.media_type %}{% when 'image' %}{% assign media_loading = 'lazy' %}{% if forloop.first %}{% assign media_loading = 'eager' %}{% endif %}<a class="product-zoom" {% if section.settings.zoom %}data-product-zoom{% endif %} href="{{ media | image_url: width: 2400 }}" target="_blank" rel="noopener" aria-label="View full size image">{{ media | image_url: width: 2000 | image_tag: loading: media_loading, widths: '400,700,1000,1400,2000', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt }}</a>{% when 'video' %}{{ media | video_tag: controls: true, image_size: '1000x', preload: 'none' }}{% when 'external_video' %}{{ media | external_video_tag: loading: 'lazy' }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder product-placeholder' }}{% endfor %}</div><div class="thumbnails">{% for media in product.media %}<button type="button" data-media-target="{{ media.id }}" aria-label="View media {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endfor %}</div></div><div class="product-info"><p class="eyebrow">{{ product.type | default: 'THE ISBLUE EDIT' | escape }}</p><h1>{{ product.title | escape }}</h1><div class="price product-main-price"><span data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span><s data-product-compare>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}{{ product.selected_or_first_available_variant.compare_at_price | money }}{% endif %}</s></div><p class="tax-note">{% if cart.taxes_included %}Tax included. {% endif %}Shipping calculated at checkout.</p>{% form 'product', product, data-product-form: '', class: 'main-product-form' %}{% unless product.has_only_default_variant %}<label for="Variant-{{ section.id }}">Choose your option</label>{% endunless %}<select name="id" id="Variant-{{ section.id }}" data-variant-select {% if product.has_only_default_variant %}class="visually-hidden" aria-label="Product variant"{% endif %}>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select><div class="purchase-row"><div class="quantity"><button type="button" data-quantity="-1" aria-label="Decrease quantity">−</button><label class="visually-hidden" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" min="1" value="1" name="quantity" inputmode="numeric"><button type="button" data-quantity="1" aria-label="Increase quantity">+</button></div><button type="submit" class="button button-primary" data-add-button {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}Add to bag{% else %}Sold out{% endif %} {% render 'icon', name: 'handbag' %}</button></div><p class="form-message" role="status"></p>{% if section.settings.dynamic_checkout %}{{ form | payment_button }}{% endif %}{% endform %}<div class="purchase-benefits"><span>{% render 'icon', name: 'shield-check' %} Secure checkout</span><a href="/pages/contact">{% render 'icon', name: 'chat-circle-text' %} Need a hand?</a></div>{% if product.description != blank %}<a class="product-details-link" href="#ProductDetails-{{ section.id }}">Discover the details ↘</a>{% endif %}<details class="product-disclosure"><summary>Delivery & returns {% render 'icon', name: 'plus' %}</summary><p>Find delivery information in our <a href="/policies/shipping-policy">shipping policy</a> and eligibility in our <a href="/policies/refund-policy">returns policy</a>. Contact us if you need help before ordering.</p></details>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% endcase %}{% endfor %}</div></div>
{% if section.settings.show_videos %}
{% assign video_count = 0 %}{% for media in product.media %}{% if media.media_type == 'video' or media.media_type == 'external_video' %}{% assign video_count = video_count | plus: 1 %}{% endif %}{% endfor %}
{% if video_count > 0 %}<section class="product-film" aria-labelledby="FilmHeading-{{ section.id }}">
<header class="product-story-heading" data-product-step><p class="eyebrow">A closer look</p><h2 id="FilmHeading-{{ section.id }}">{{ section.settings.video_heading | escape }}</h2></header>
<div class="product-film-grid">{% for media in product.media %}{% if media.media_type == 'video' or media.media_type == 'external_video' %}
<figure class="product-film-card" data-product-step><div class="product-film-player" style="--media-ratio:{{ media.aspect_ratio | default: 1.7778 }}">{% if media.media_type == 'video' %}{{ media | video_tag: controls: true, image_size: '1400x', preload: 'none' }}{% else %}{{ media | external_video_tag: loading: 'lazy' }}{% endif %}</div>{% if media.alt != blank %}<figcaption>{{ media.alt | escape }}</figcaption>{% endif %}</figure>
{% endif %}{% endfor %}</div></section>{% endif %}{% endif %}
{% if product.description != blank %}<section class="product-story" id="ProductDetails-{{ section.id }}" aria-labelledby="DetailsHeading-{{ section.id }}"><header class="product-story-heading" data-product-step><p class="eyebrow">The details</p><h2 id="DetailsHeading-{{ section.id }}">{{ section.settings.details_heading | escape }}</h2></header><div class="rte product-description" data-product-description>{{ product.description }}</div></section>{% endif %}
<noscript><style>.product-universal [data-media-id][hidden]{display:block!important}.product-universal .thumbnails{display:none}</style></noscript>
<script type="application/json" data-variants>{{ product.variants | json }}</script></section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}{"name":"Product information","settings":[{"type":"checkbox","id":"zoom","label":"Enable desktop hover zoom","default":true},{"type":"checkbox","id":"reveal","label":"Enable scroll reveals","default":true},{"type":"checkbox","id":"show_videos","label":"Show product video showcase","default":true},{"type":"checkbox","id":"dynamic_checkout","label":"Show dynamic checkout","default":true},{"type":"text","id":"video_heading","label":"Video heading","default":"See it in action."},{"type":"text","id":"details_heading","label":"Description heading","default":"Get to know your next favourite."}],"blocks":[{"type":"@app"}]}{% endschema %}
