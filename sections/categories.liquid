<section class="category-section section-space page-width" data-motion-section><div class="section-heading"><div><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div></div><div class="category-grid">{% for block in section.blocks %}<a class="category-tile category-tile-{{ forloop.index }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="category-copy"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.subtitle | escape }}</p></div><span class="round-arrow">{% render 'icon', name: 'arrow-up-right' %}</span>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'category-image', alt: block.settings.title }}{% elsif block.settings.product.featured_image %}{{ block.settings.product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'category-image', alt: block.settings.title }}{% else %}<img class="category-image" src="{{ block.settings.fallback | append: '.webp' | asset_url }}" width="800" height="800" loading="lazy" alt="{{ block.settings.title | escape }}">{% endif %}</a>{% endfor %}</div></section>
{% schema %}{"name":"Category atlas","settings":[{"type":"text","id":"heading","label":"Heading","default":"Whatever your everyday looks like."},{"type":"text","id":"description","label":"Description","default":"Find a little something for every part of it."}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"title","label":"Title","default":"Smart little things."},{"type":"text","id":"subtitle","label":"Subtitle","default":"Gadgets with a good idea."},{"type":"url","id":"link","label":"Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"product","id":"product","label":"Product image"},{"type":"select","id":"fallback","label":"Bundled image","default":"printer","options":[{"value":"printer","label":"Pocket printer"},{"value":"storage","label":"Home storage"},{"value":"blender","label":"Portable blender"}]}]}],"max_blocks":3,"presets":[{"name":"Category atlas","blocks":[{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}
