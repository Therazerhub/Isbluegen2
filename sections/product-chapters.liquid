{% liquid
  assign entries = product.metafields.custom.product_story.value
  assign use_entries = false
  if section.settings.source == 'product' and entries != blank
    assign use_entries = true
  endif
  assign chapter_count = 0
%}
{% capture chapters %}
  {% if use_entries %}
    {% for entry in entries %}
      {% if entry.heading.value != blank %}
        {% assign chapter_count = chapter_count | plus: 1 %}
        {% capture entry_body %}{% if entry.body != blank %}{{ entry.body | metafield_tag }}{% endif %}{% endcapture %}
        {% render 'product-chapter', section_id: section.id, index: chapter_count, eyebrow: entry.eyebrow.value, heading: entry.heading.value, body: entry_body, image: entry.image.value, mobile_image: entry.mobile_image.value, video: entry.video.value, button_label: entry.button_label.value, button_url: entry.button_url.value, image_side: 'left' %}
      {% endif %}
    {% endfor %}
  {% elsif section.settings.source == 'blocks' %}
    {% for block in section.blocks %}
      {% if block.settings.enabled and block.settings.heading != blank %}
        {% assign chapter_count = chapter_count | plus: 1 %}
        {% render 'product-chapter', section_id: section.id, index: chapter_count, eyebrow: block.settings.eyebrow, heading: block.settings.heading, body: block.settings.body, image: block.settings.image, mobile_image: block.settings.mobile_image, video: block.settings.video, button_label: block.settings.button_label, button_url: block.settings.button_url, image_side: block.settings.image_side, editor_attributes: block.shopify_attributes %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endcapture %}
{% if chapter_count > 0 %}
<section class="cinematic-chapters" data-chapters data-motion="{{ section.settings.motion }}" data-layout="{{ section.settings.layout }}" style="--chapter-bg:{{ section.settings.background }};--chapter-ink:{{ section.settings.text_color }};--chapter-accent:{{ section.settings.accent }};--chapter-space:{{ section.settings.spacing }}px;--chapter-fit:{{ section.settings.image_fit }};--chapter-radius:{{ section.settings.radius }}px" aria-labelledby="ChaptersHeading-{{ section.id }}">
  <div class="page-width">
    <header class="chapters-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="ChaptersHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p class="chapters-hint">Scroll to explore <span aria-hidden="true">↓</span></p></header>
    <div class="chapters-track">
      <div class="chapter-stage" aria-hidden="true"><div class="chapter-visuals"></div><div class="chapter-progress"><span data-chapter-current>01</span><span class="chapter-progress-line"></span><span>{{ chapter_count | prepend: '0' }}</span></div></div>
      <div class="chapter-steps">{{ chapters }}</div>
    </div>
  </div>
</section>
{% elsif request.design_mode %}
<div class="page-width section-space"><h2>Cinematic chapters</h2><p>Add product story entries to custom.product_story, or choose “Theme editor blocks” and add a chapter. This message is only visible in the editor.</p></div>
{% endif %}
{% schema %}
{
 "name":"Cinematic chapters","tag":"section","enabled_on":{"templates":["product"]},
 "settings":[
 {"type":"select","id":"source","label":"Chapter content","default":"product","options":[{"value":"product","label":"Product story metafield"},{"value":"blocks","label":"Theme editor blocks"}],"info":"Product mode reads custom.product_story (list of metaobjects). Blocks are shared across products using this template unless connected to dynamic sources."},
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A closer look"},
 {"type":"text","id":"heading","label":"Heading","default":"Made for your everyday."},
 {"type":"select","id":"layout","label":"Desktop experience","default":"cinematic","options":[{"value":"cinematic","label":"Sticky image chapters"},{"value":"stacked","label":"Image and text rows"}]},
 {"type":"checkbox","id":"motion","label":"Enable scroll transitions","default":true},
 {"type":"select","id":"image_fit","label":"Image fit","default":"contain","options":[{"value":"contain","label":"Show entire image"},{"value":"cover","label":"Fill image area"}]},
 {"type":"color","id":"background","label":"Background","default":"#0b1829"},
 {"type":"color","id":"text_color","label":"Text","default":"#f4f7ff"},
 {"type":"color","id":"accent","label":"Accent","default":"#90b8ff"},
 {"type":"range","id":"spacing","label":"Section spacing","min":24,"max":120,"step":8,"unit":"px","default":64},
 {"type":"range","id":"radius","label":"Image corner radius","min":0,"max":32,"step":2,"unit":"px","default":4}
 ],
 "blocks":[{"type":"chapter","name":"Feature chapter","settings":[
 {"type":"checkbox","id":"enabled","label":"Show chapter","default":true},
 {"type":"text","id":"eyebrow","label":"Eyebrow"},
 {"type":"text","id":"heading","label":"Heading","default":"A thoughtful detail."},
 {"type":"richtext","id":"body","label":"Description"},
 {"type":"image_picker","id":"image","label":"Image"},
 {"type":"image_picker","id":"mobile_image","label":"Mobile image"},
 {"type":"video","id":"video","label":"Video","info":"Optional. Videos use controls and never autoplay."},
 {"type":"select","id":"image_side","label":"Image position in stacked layout","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
 {"type":"text","id":"button_label","label":"Link label"},
 {"type":"url","id":"button_url","label":"Link"}
 ]}],
 "presets":[{"name":"Cinematic chapters","settings":{"source":"blocks"},"blocks":[{"type":"chapter"},{"type":"chapter"}]}]
}
{% endschema %}
