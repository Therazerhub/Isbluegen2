{% assign featured = section.settings.featured_product %}
{% assign secondary = section.settings.secondary_product %}
{% assign tertiary = section.settings.tertiary_product %}
{% if featured == blank %}{% assign featured = collections.all.products.first %}{% endif %}
{% if secondary == blank %}{% assign secondary = collections.all.products[1] %}{% endif %}
{% if tertiary == blank %}{% assign tertiary = collections.all.products[2] %}{% endif %}
<section class="hero hero--conversion page-width" data-section-id="{{ section.id }}">
  <div class="hero-copy hero-conversion-copy">
    <p class="eyebrow"><span class="tiny-line"></span>{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}<span>{{ section.settings.heading_accent | escape }}</span></h1>
    <p class="hero-description">{{ section.settings.description | escape }}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} {% render 'icon', name: 'arrow-up-right' %}</a>
      {% if featured != blank %}<a class="button button-secondary" href="{{ featured.url }}">Shop the bestseller {% render 'icon', name: 'arrow-up-right' %}</a>{% endif %}
    </div>
    <div class="hero-trust" aria-label="Shopping benefits">
      <span>{% render 'icon', name: 'check' %}<strong>Cash on Delivery</strong></span>
      <span>{% render 'icon', name: 'sparkle' %}<strong>Premium-quality picks</strong></span>
      <span>{% render 'icon', name: 'shield-check' %}<strong>Secure checkout</strong></span>
    </div>
    <p class="hero-fineprint">COD availability is confirmed for eligible orders at checkout.</p>
  </div>
  <div class="hero-product-stage" aria-label="Featured IsBlue products">
    {% if featured != blank %}
      <a class="hero-featured-product" href="{{ featured.url }}">
        <div class="hero-featured-badges"><span>ISBLUE PICK</span>{% if featured.compare_at_price > featured.price %}{% assign saving = featured.compare_at_price | minus: featured.price | times: 100.0 | divided_by: featured.compare_at_price | round %}<strong>{{ saving }}% OFF</strong>{% endif %}</div>
        <div class="hero-featured-media">{% if featured.featured_image %}{{ featured.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500,750,1000,1400', sizes: '(max-width: 767px) 92vw, 52vw', alt: featured.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'hero-product-placeholder' }}{% endif %}</div>
        <div class="hero-featured-info"><div><span>{{ featured.type | default: 'Everyday upgrade' | escape }}</span><h2>{{ featured.title | split: ' — ' | first | escape }}</h2></div><p class="price">{{ featured.price | money }}{% if featured.compare_at_price > featured.price %}<s>{{ featured.compare_at_price | money }}</s>{% endif %}</p></div>
      </a>
    {% else %}
      <div class="hero-art"><img class="hero-image" src="{{ 'hero-blue.webp' | asset_url }}" width="1536" height="1024" alt="IsBlue premium everyday products" fetchpriority="high"></div>
    {% endif %}
    <div class="hero-mini-products">
      {% for item in (1..2) %}{% if item == 1 %}{% assign mini_product = secondary %}{% else %}{% assign mini_product = tertiary %}{% endif %}
        {% if mini_product != blank %}<a href="{{ mini_product.url }}" class="hero-mini-card"><div>{% if mini_product.featured_image %}{{ mini_product.featured_image | image_url: width: 420 | image_tag: loading: 'eager', widths: '180,280,420', sizes: '(max-width: 767px) 42vw, 180px', alt: mini_product.title }}{% endif %}</div><span>{{ mini_product.title | split: ' — ' | first | escape }}</span></a>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
<div class="service-strip service-strip--conversion page-width">
  <span>{% render 'icon', name: 'truck' %}<strong>Cash on Delivery</strong><small>On eligible orders</small></span>
  <span>{% render 'icon', name: 'sparkle' %}<strong>Premium selection</strong><small>Useful finds, elevated</small></span>
  <span>{% render 'icon', name: 'shield-check' %}<strong>Secure Shopify checkout</strong><small>Protected payment flow</small></span>
  <span>{% render 'icon', name: 'chat-circle-text' %}<strong>Helpful support</strong><small>A message away</small></span>
</div>
{% schema %}
{
  "name": "Conversion hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE ISBLUE PREMIUM EDIT"},
    {"type":"text","id":"heading","label":"Heading","default":"Premium finds."},
    {"type":"text","id":"heading_accent","label":"Accent line","default":"Live smarter."},
    {"type":"textarea","id":"description","label":"Description","default":"Quality-focused gadgets, home upgrades and personal essentials selected to make everyday routines feel easier."},
    {"type":"text","id":"button","label":"Button label","default":"Shop best sellers"},
    {"type":"url","id":"link","label":"Button link"},
    {"type":"product","id":"featured_product","label":"Featured product"},
    {"type":"product","id":"secondary_product","label":"Secondary product"},
    {"type":"product","id":"tertiary_product","label":"Tertiary product"}
  ],
  "presets":[{"name":"Conversion hero"}]
}
{% endschema %}
