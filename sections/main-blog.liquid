<section class="page-width section-space">
  <header class="collection-heading"><p class="eyebrow">The IsBlue journal</p><h1>{{ blog.title }}</h1><p>Fresh ideas for making everyday life feel a little smarter.</p></header>
  {% paginate blog.articles by 12 %}
    <div class="journal-grid">
      {% for article in blog.articles %}
        <article class="journal-card"><a href="{{ article.url }}">
          <div class="journal-media">{% if article.image %}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', sizes: '(max-width: 767px) 100vw, 33vw', alt: article.title }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div>
          <p class="eyebrow">{{ article.published_at | date: '%d %b %Y' }}</p><h2>{{ article.title }}</h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p><span class="text-link">Read the story {% render 'icon', name: 'arrow-up-right' %}</span>
        </a></article>
      {% else %}
        <div class="empty-state"><h2>Stories are brewing.</h2><p>Publish your first article in Shopify admin and it will appear here.</p></div>
      {% endfor %}
    </div>
    <div class="pagination">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
</section>
{% schema %}
{"name":"Blog","settings":[]}
{% endschema %}
