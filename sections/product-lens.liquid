{% liquid
  assign first_image = section.settings.first_image
  assign second_image = section.settings.second_image
  assign image_position = 0
  for media in product.media
    if media.media_type == 'image'
      assign image_position = image_position | plus: 1
      if image_position == 2 and first_image == blank
        assign first_image = media.preview_image
      elsif image_position == 3 and second_image == blank
        assign second_image = media.preview_image
      endif
    endif
  endfor
%}
{% if section.settings.enabled and first_image != blank %}
<section class="product-lens" data-motion-section aria-labelledby="LensHeading-{{ section.id }}" style="--lens-accent:{{ section.settings.accent_color }};--lens-surface:{{ section.settings.background_color }};--lens-fit:{{ section.settings.image_fit }}">
  <div class="page-width product-lens-inner">
    <div class="product-lens-copy">
      <p class="product-lens-kicker">{% render 'icon', name: 'sparkle' %} {{ section.settings.eyebrow | escape }}</p>
      <h2 id="LensHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p class="product-lens-product">{% if section.settings.caption != blank %}{{ section.settings.caption | escape }}{% else %}{{ product.type | default: 'The IsBlue edit' | escape }} <span aria-hidden="true">/</span> {{ product.media.size }} views{% endif %}</p>
      <div class="product-lens-rule" aria-hidden="true"><span></span></div>
      <p class="product-lens-footnote">{{ section.settings.footer_text | escape }}</p>
    </div>
    <div class="product-lens-visuals">
      <figure class="product-lens-photo product-lens-photo-main">
        {{ first_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', sizes: '(min-width: 990px) 48vw, 90vw', alt: first_image.alt }}
        <figcaption>01 / In focus</figcaption>
      </figure>
      {% if second_image != blank %}
        <figure class="product-lens-photo product-lens-photo-secondary">
          {{ second_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240,400,700', sizes: '(min-width: 990px) 20vw, 40vw', alt: second_image.alt }}
          <figcaption>02 / Another angle</figcaption>
        </figure>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Product visual focus",
  "tag": "section",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type": "checkbox", "id": "enabled", "label": "Show visual focus", "default": true},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE DETAILS"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Look a little closer."},
    {"type": "text", "id": "caption", "label": "Optional caption", "info": "When blank, shows the product category and media count."},
    {"type": "text", "id": "footer_text", "label": "Small footer note", "default": "A closer view of the things worth noticing."},
    {"type": "image_picker", "id": "first_image", "label": "First image override", "info": "Otherwise uses the product's second image."},
    {"type": "image_picker", "id": "second_image", "label": "Second image override", "info": "Otherwise uses the product's third image."},
    {"type": "select", "id": "image_fit", "label": "Image crop", "default": "contain", "options": [{"value": "contain", "label": "Show full image"}, {"value": "cover", "label": "Fill image area"}]},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#1859d3"},
    {"type": "color", "id": "background_color", "label": "Background color", "default": "#f4f8ff"}
  ],
  "presets": [{"name": "Product visual focus"}]
}
{% endschema %}
