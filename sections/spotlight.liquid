{% assign featured = section.settings.product %}{% if featured == blank %}{% assign featured = collections.all.products.first %}{% endif %}
<section class="spotlight-wrap page-width section-space" data-motion-section><div class="spotlight"><a class="spotlight-image" href="{{ featured.url | default: routes.all_products_collection_url }}">{% if featured.featured_image %}{{ featured.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: featured.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'home-placeholder' }}{% endif %}</a><div class="spotlight-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p>{% if featured != blank %}<p class="price spotlight-price">{{ featured.price | money }}{% if featured.compare_at_price > featured.price %}<s>{{ featured.compare_at_price | money }}</s>{% endif %}</p><a class="button button-primary" href="{{ featured.url }}">Explore this solution {% render 'icon', name: 'arrow-up-right' %}</a>{% else %}<a class="button button-primary" href="{{ routes.all_products_collection_url }}">Explore the collection {% render 'icon', name: 'arrow-up-right' %}</a>{% endif %}</div></div></section>
{% schema %}{"name":"Product spotlight","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A PRACTICAL SOLUTION"},{"type":"text","id":"heading","label":"Heading","default":"A useful addition to your everyday."},{"type":"textarea","id":"description","label":"Description","default":"Explore the details, see the product up close, and decide if it fits your routine."}],"presets":[{"name":"Product spotlight"}]}{% endschema %}
