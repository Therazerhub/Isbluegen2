{% assign featured = section.settings.product %}
<section class="spotlight-wrap page-width section-space" data-motion-section>
  <div class="spotlight spotlight--conversion">
    {% if featured != blank %}
      <a class="spotlight-image" href="{{ featured.url }}">{% if featured.featured_image %}{{ featured.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(max-width: 767px) 100vw, 55vw', alt: featured.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'spotlight-placeholder' }}{% endif %}</a>
      <div class="spotlight-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><div class="spotlight-trust"><span>{% render 'icon', name: 'truck' %} COD available</span><span>{% render 'icon', name: 'shield-check' %} Secure checkout</span></div><p class="price spotlight-price">{{ featured.price | money }}{% if featured.compare_at_price > featured.price %}<s>{{ featured.compare_at_price | money }}</s>{% endif %}</p><a class="button button-primary" href="{{ featured.url }}">Shop this IsBlue pick {% render 'icon', name: 'arrow-up-right' %}</a></div>
    {% else %}
      <div class="spotlight-image spotlight-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div><div class="spotlight-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="button button-primary" href="{{ routes.all_products_collection_url }}">Explore the collection {% render 'icon', name: 'arrow-up-right' %}</a></div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Product spotlight","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PREMIUM PICK · CASH ON DELIVERY"},{"type":"text","id":"heading","label":"Heading","default":"A cleaner home, with less effort."},{"type":"textarea","id":"description","label":"Description","default":"Meet the versatile everyday upgrade customers notice first—presented with clear pricing, premium imagery and an easier path to checkout."}],"presets":[{"name":"Product spotlight"}]}{% endschema %}
