{% assign featured = section.settings.product %}{% if featured == blank %}{% assign featured = all_products['mini-bluetooth-thermal-printer-inkless-pocket-printer-for-mobile-label-sticker-printer'] %}{% endif %}
<section class="spotlight-wrap page-width section-space" data-motion-section><div class="spotlight"><a class="spotlight-image" href="{{ featured.url | default: routes.all_products_collection_url }}">{% if featured.featured_image %}{{ featured.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: featured.title }}{% else %}<img src="{{ 'printer.webp' | asset_url }}" width="800" height="800" loading="lazy" alt="Pocket thermal printer">{% endif %}</a><div class="spotlight-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p>{% if featured != blank %}<p class="price spotlight-price">{{ featured.price | money }}{% if featured.compare_at_price > featured.price %}<s>{{ featured.compare_at_price | money }}</s>{% endif %}</p><a class="button button-primary" href="{{ featured.url }}">Take a closer look {% render 'icon', name: 'arrow-up-right' %}</a>{% else %}<a class="button button-primary" href="{{ routes.all_products_collection_url }}">Explore the collection {% render 'icon', name: 'arrow-up-right' %}</a>{% endif %}</div></div></section>
{% schema %}{"name":"Product spotlight","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SMALL FIND. BIG POSSIBILITIES."},{"type":"text","id":"heading","label":"Heading","default":"From your phone. Into your world."},{"type":"textarea","id":"description","label":"Description","default":"Notes, labels, little memories. Meet the pocket printer that gives your ideas somewhere to go."}],"presets":[{"name":"Product spotlight"}]}{% endschema %}
