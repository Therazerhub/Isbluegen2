<section class="page-width section-space contact-page"><div><p class="eyebrow">HERE TO HELP</p><h1>Let's talk.</h1><p>A question about an order or a find that caught your eye? Send us a message.</p><div class="rte">{{ page.content }}</div></div>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p role="status">Your message is on its way. We'll get back to you soon.</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name" required><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required><label for="ContactOrder">Order number (optional)</label><input id="ContactOrder" name="contact[order_number]"><label for="ContactMessage">Your message</label><textarea id="ContactMessage" name="contact[body]" rows="6" required></textarea><button class="button button-primary" type="submit">Send message {% render 'icon', name: 'arrow-up-right' %}</button>{% endform %}</section>
{% schema %}{"name":"Contact form","settings":[]}{% endschema %}
