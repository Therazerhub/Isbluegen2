<section class="ib ib-home-trust" aria-label="Shopping benefits">
  <div class="ib-wrap ib-home-trust__grid">
    {% for block in section.blocks %}
      <div class="ib-home-trust__item" {{ block.shopify_attributes }}>
        <span class="ib-home-trust__icon">{% render 'isblue-icon', icon: block.settings.icon %}</span>
        <div><h2>{{ block.settings.title | escape }}</h2><p>{{ block.settings.text | escape }}</p></div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "IsBlue trust strip",
  "max_blocks": 4,
  "settings": [],
  "blocks": [{
    "type": "benefit",
    "name": "Benefit",
    "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "truck", "label": "Truck" },
        { "value": "shield", "label": "Shield" },
        { "value": "cash", "label": "Cash" },
        { "value": "headphones", "label": "Support" },
        { "value": "box", "label": "Box" }
      ], "default": "box" },
      { "type": "text", "id": "title", "label": "Title", "default": "Secure shopping" },
      { "type": "text", "id": "text", "label": "Description", "default": "Made simple for you" }
    ]
  }],
  "presets": [{ "name": "IsBlue trust strip" }]
}
{% endschema %}
