<section class="ib ib-wrap ib-home-values" aria-label="Why shop IsBlue">
  <div class="ib-home-values-grid">
    {% for block in section.blocks %}<div class="ib-home-value" {{ block.shopify_attributes }}><span>{% render 'isblue-icon', icon: block.settings.icon %}</span><div><h2>{{ block.settings.title | escape }}</h2><p>{{ block.settings.text | escape }}</p></div></div>{% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "IsBlue value highlights",
  "max_blocks": 4,
  "settings": [],
  "blocks": [{ "type": "value", "name": "Value", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [
      { "value": "shield", "label": "Quality" }, { "value": "tag", "label": "Price" }, { "value": "spark", "label": "Trending" }, { "value": "heart", "label": "Trusted" }
    ], "default": "shield" },
    { "type": "text", "id": "title", "label": "Title", "default": "Thoughtfully Selected" },
    { "type": "text", "id": "text", "label": "Description", "default": "Useful products for everyday life" }
  ] }],
  "presets": [{ "name": "IsBlue value highlights" }]
}
{% endschema %}
