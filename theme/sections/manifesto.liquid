<section class="manifesto section-space page-width" data-motion-section><div class="manifesto-icon">{% render 'icon', name: 'asterisk' %}</div><h2 data-word-reveal>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></section>
