<section class="product-page page-width section-space" data-product-page><nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.all_products_collection_url }}">Products</a></nav><div class="product-layout"><div class="product-gallery"><div class="main-media">{% for media in product.media %}<div data-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>{% case media.media_type %}{% when 'image' %}<a href="{{ media | image_url: width: 2000 }}" target="_blank" rel="noopener" aria-label="View full size image">{{ media | image_url: width: 1400 | image_tag: loading: 'eager', alt: media.alt }}</a>{% when 'video' %}{{ media | video_tag: controls: true, image_size: '1000x', preload: 'metadata' }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}</div>{% endfor %}</div><div class="thumbnails">{% for media in product.media %}<button type="button" data-media-target="{{ media.id }}" aria-label="View media {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endfor %}</div></div><div class="product-info"><p class="eyebrow">{{ product.type | default: 'THE ISBLUE EDIT' | escape }}</p><h1>{{ product.title | split: ' — ' | first | split: ' | ' | first | escape }}</h1><div class="price product-main-price"><span data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span><s data-product-compare>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}{{ product.selected_or_first_available_variant.compare_at_price | money }}{% endif %}</s></div><p class="tax-note">{% if cart.taxes_included %}Tax included. {% endif %}Shipping calculated at checkout.</p>{% form 'product', product, data-product-form: '', class: 'main-product-form' %}{% unless product.has_only_default_variant %}<label for="Variant-{{ section.id }}">Choose your option</label>{% endunless %}<select name="id" id="Variant-{{ section.id }}" data-variant-select {% if product.has_only_default_variant %}class="visually-hidden" aria-label="Product variant"{% endif %}>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select><div class="purchase-row"><div class="quantity"><button type="button" data-quantity="-1" aria-label="Decrease quantity">−</button><label class="visually-hidden" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" min="1" value="1" name="quantity" inputmode="numeric"><button type="button" data-quantity="1" aria-label="Increase quantity">+</button></div><button type="submit" class="button button-primary" data-add-button {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %} {% render 'icon', name: 'handbag' %}</button></div><p class="form-message" role="status"></p>{{ form | payment_button }}{% endform %}<div class="purchase-benefits"><span>{% render 'icon', name: 'shield-check' %} Secure checkout</span><a href="/pages/contact">{% render 'icon', name: 'chat-circle-text' %} Need a hand?</a></div><details class="product-disclosure" open><summary>The good details {% render 'icon', name: 'plus' %}</summary><div class="rte">{{ product.description }}</div></details><details class="product-disclosure"><summary>Delivery & returns {% render 'icon', name: 'plus' %}</summary><p>Find delivery information in our <a href="/policies/shipping-policy">shipping policy</a> and eligibility in our <a href="/policies/refund-policy">returns policy</a>. Contact us if you need help before ordering.</p></details>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% endcase %}{% endfor %}</div></div><script type="application/json" data-variants>{{ product.variants | json }}</script></section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}{"name":"Product information","settings":[],"blocks":[{"type":"@app"}]}{% endschema %}
