<section class="page-width section-space"><h1>Good finds start here.</h1><form class="search-form page-search" action="{{ routes.search_url }}"><label class="visually-hidden" for="PageSearch">Search products</label><input id="PageSearch" name="q" type="search" value="{{ search.terms | escape }}" placeholder="Find your next favourite"><input type="hidden" name="type" value="product"><button class="icon-button" type="submit" aria-label="Search">{% render 'icon', name: 'magnifying-glass' %}</button></form>{% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% paginate search.results by 24 %}<div class="product-grid">{% for product in search.results %}{% if product.object_type == 'product' %}{% render 'product-card', product: product %}{% endif %}{% else %}<div class="empty-state"><h2>Nothing quite matches yet.</h2><p>Try a simpler search or browse the full edit.</p><a class="button button-primary" href="{{ routes.all_products_collection_url }}">Explore all products</a></div>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Search results","settings":[]}{% endschema %}
