<section class="page-width section-space cart-page"><h1>Your good finds.</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-page-items">{% for item in cart.items %}<div class="cart-page-item">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}<div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2><p>{{ item.variant.title | escape }}</p><strong>{{ item.final_line_price | money }}</strong><a href="{{ item.url_to_remove }}">Remove</a></div><label>Quantity<input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.title | escape }}"></label></div>{% endfor %}</div><div class="cart-page-summary"><label for="CartNote">Order note</label><textarea name="note" id="CartNote">{{ cart.note | escape }}</textarea><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p>Shipping, taxes, and discounts calculated at checkout.</p><div class="purchase-row"><button class="button" name="update">Update bag</button><button class="button button-primary" name="checkout">Continue to checkout</button></div></div></form>{% else %}<div class="empty-state"><h2>Room for something good.</h2><p>Your bag is empty. Let's find your next favourite.</p><a href="{{ routes.all_products_collection_url }}" class="button button-primary">Explore the edit</a></div>{% endif %}</section>
{% schema %}{"name":"Shopping bag","settings":[]}{% endschema %}
