<section class="section-space page-width" id="{{ section.settings.anchor | default: section.id }}" data-motion-section>
  <div class="section-heading"><div><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | default: 'Shop all finds' }} {% render 'icon', name: 'arrow-up-right' %}</a></div>
  {% assign selected_collection = section.settings.collection | default: collections.all %}
  {% assign selected_products = section.settings.products | default: selected_collection.products %}
  <div class="product-rail">{% for product in selected_products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<div class="empty-state"><h3>Your next discovery is on its way.</h3><p>Choose a collection in the theme editor to feature your products here.</p></div>{% endfor %}</div>
</section>
{% schema %}{"name":"Product edit","settings":[{"type":"text","id":"heading","label":"Heading","default":"Worth a spot in your day."},{"type":"text","id":"description","label":"Description","default":"A few of our favourite everyday discoveries."},{"type":"product_list","id":"products","label":"Handpicked products","limit":12},{"type":"collection","id":"collection","label":"Fallback collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":4},{"type":"text","id":"link_label","label":"Link label","default":"Shop all finds"},{"type":"text","id":"anchor","label":"Section anchor","default":"bestsellers"}],"presets":[{"name":"Product edit"}]}{% endschema %}
