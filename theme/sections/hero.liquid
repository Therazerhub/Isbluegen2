<section class="hero page-width" data-motion-section data-section-id="{{ section.id }}">
  <div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span>{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}<br><span>{{ section.settings.heading_accent | escape }}</span></h1><p class="hero-description">{{ section.settings.description | escape }}</p><a class="button button-primary" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} {% render 'icon', name: 'arrow-up-right' %}</a><a class="hero-secondary" href="#bestsellers">Find your favourites {% render 'icon', name: 'arrow-down' %}</a></div>
  <div class="hero-art">
    {% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500,750,1100,1600', sizes: '(max-width: 767px) 100vw, 55vw', class: 'hero-image' }}{% else %}<img class="hero-image" src="{{ 'hero-blue.webp' | asset_url }}" width="1536" height="1024" alt="Sculptural blue glass shopping bag in soft studio light" fetchpriority="high">{% endif %}
    {% if section.settings.enable_effect %}<div class="hero-effect" data-threeui data-speed="{{ section.settings.effect_speed }}" aria-hidden="true"></div>{% endif %}
    <div class="hero-art-caption"><span>GOOD FINDS. GREAT FEELING.</span>{% render 'icon', name: 'asterisk' %}</div>
  </div>
</section>
<div class="service-strip page-width"><span>{% render 'icon', name: 'sparkle' %} Little upgrades for everyday life</span><span>{% render 'icon', name: 'shield-check' %} Secure Shopify checkout</span><span>{% render 'icon', name: 'chat-circle-text' %} Real help, a message away</span></div>
{% schema %}{"name":"Signature hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE ISBLUE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Good finds."},{"type":"text","id":"heading_accent","label":"Accent line","default":"Better days."},{"type":"textarea","id":"description","label":"Description","default":"Useful gadgets, clever home upgrades, and little things that make a big difference."},{"type":"text","id":"button","label":"Button label","default":"Explore the edit"},{"type":"url","id":"link","label":"Button link"},{"type":"image_picker","id":"image","label":"Hero artwork"},{"type":"checkbox","id":"enable_effect","label":"Enable ThreeUI atmosphere","default":true},{"type":"range","id":"effect_speed","label":"Effect speed","min":1,"max":10,"step":1,"default":2}],"presets":[{"name":"Signature hero"}]}{% endschema %}
