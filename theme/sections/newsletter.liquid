<section class="newsletter section-space page-width" data-motion-section><div><h2>A little blue<br>in your inbox.</h2><p>Fresh finds, new arrivals, and a reason to treat yourself.</p></div>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="Email-{{ section.id }}">Your email address</label><div class="email-row"><input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="you@example.com"><button type="submit" aria-label="Subscribe to the newsletter">{% render 'icon', name: 'arrow-up-right' %}</button></div>{% if form.posted_successfully? %}<p role="status">You're on the list. Welcome to IsBlue.</p>{% endif %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}<p class="fine-print">By subscribing, you agree to our <a href="/policies/privacy-policy">privacy policy</a>. Unsubscribe whenever you like.</p>{% endform %}</section>
{% schema %}{"name":"Newsletter","settings":[],"presets":[{"name":"Newsletter"}]}{% endschema %}
